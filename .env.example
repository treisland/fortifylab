#:W
# FORTIFY HELM ENVIRONMEMNT VARIABLES
# -----------------------------------
#
# Single location for that makes it easier to configure
# the deployment of tools

# Requires environment variables "FORTIFY_HOME_K8S" set to the full path
# for the parent folder where this script resides

#example 
# <file: ~/bash_profile>
#
# export FORTIFY_HOME_K8S=$HOME/fortifyk8s
#
#========================================================

# set the namespace for the resource in your cluster
export NAMESPACE="fortify"

# Maximum time and polling interval for dependency health gates. A failed gate
# aborts only the current operation; fix the dependency and safely retry it.
export FORTIFY_HEALTH_TIMEOUT="600"
export FORTIFY_HEALTH_INTERVAL="5"

# Guided deployment profile. The wizard can change these non-secret values and
# creates a .env backup before writing. Supported profiles: full_lab, ssc_only,
# sast_standalone, sast_full, dast_full, custom. Custom components are a
# space-separated list such as: ssc sast_controller sast_sensor.
export FORTIFY_DEPLOYMENT_PROFILE="full_lab"
export FORTIFY_DEPLOYMENT_COMPONENTS=""

# Advanced coordinated lab target profiles. The default local profile preserves
# the single-machine path. Additional profiles are read-only until selected in
# the wizard and confirmed before deployment operations use their kube context.
export FORTIFY_CLUSTER_PROFILE="local"
export FORTIFY_CLUSTER_PROFILE_NAMES="local"
export FORTIFY_CLUSTER_PROFILE_LOCAL_ROLE="single-node"
export FORTIFY_CLUSTER_PROFILE_LOCAL_KUBE_CONTEXT=""
export FORTIFY_CLUSTER_PROFILE_LOCAL_SSH_HOST=""
export FORTIFY_CLUSTER_PROFILE_LOCAL_ENABLED_COMPONENTS=""
export FORTIFY_CLUSTER_PROFILE_LOCAL_STORAGE_CLASS="nfs"
export FORTIFY_CLUSTER_PROFILE_LOCAL_INGRESS_MODE="microk8s-traefik"

#--------------------------
# SECTION: CREDENTIALS
#--------------------------
# Defined first so other sections (CERTIFICATES, etc.) can reference $DEFAULT_PASS

export DEFAULT_PASS="changeme"

export DEFAULT_ALIAS="fortify"

export SCDAST_SSC_USER="scdast"

export SCDAST_SSC_PASS="change-me-in-env"

export SCDAST_DB_OWNER_USER="postgres"

#change this if you don't want to use the default password
export SCDAST_DB_OWNER_PASS=$DEFAULT_PASS

export SCDAST_DB_STANDARD_USER="dast_user"

#change this if you don't want to use the default password
export SCDAST_DB_STANDARD_PASS=$DEFAULT_PASS

export LIM_POOL_NAME="Default"

#change this if you don't want to use the default password
export LIM_POOL_PASS=$DEFAULT_PASS

#--------------------------
# SECTION: SECRETS
#--------------------------
export FORTIFY_SECRETS=$FORTIFY_HOME_K8S/secrets
export FORTIFY_SECRETS_INPUT=$FORTIFY_SECRETS/input
export FORTIFY_SECRETS_TEMPLATES=$FORTIFY_SECRETS/templates
export FORTIFY_SECRETS_GENERATED=$FORTIFY_SECRETS/generated

# May point outside the repository. The historical repository-local location
# remains the default. Never commit the license or include it in support data.
export FORTIFY_LICENSE_FILE="${FORTIFY_LICENSE_FILE:-$FORTIFY_SECRETS_INPUT/fortify.license}"

#--------------------------
# SECTION: DOMAINS
#--------------------------

export FORTIFY_RULES_DOMAIN="update.fortify.com"

# Optional root for online wizard help. Offline topics never require this site.
export FORTIFY_DOCS_BASE_URL="https://treisland.github.io/fortifylab"

# set the top-level domain name
export DOMAIN="fortifydemo.com"

export SSC="ssc.$DOMAIN"
export LIM="lim.$DOMAIN"
export SCDAST="dast.$DOMAIN"
export SCSAST="sast.$DOMAIN"

#--------------------------
# SECTION: URLS
#--------------------------

# NOTE: #using ingress addresses is recommended for full access
# internal service names can be used however there are UI issues
# when that internal address is used by an client outside of the cluster
# such as setting up SCDAST url in SSC

export SSC_URL="https://$SSC"
export LIM_URL="https://$LIM"
export LIM_API_URL="https://$LIM/LIM.API"
export SCDAST_URL="https://$SCDAST"
export SCSAST_URL="https://$SCSAST"
export SCSAST_CTRL_URL="https://$SCSAST/scancentral-ctrl/"

#--------------------------
# SECTION: CERTIFICATES
#--------------------------

# Choose TLS source mode. mkcert is the default for local labs. byo validates
# operator-provided PEM files and copies them into the generated cert layout.
export FORTIFY_TLS_MODE="mkcert"

# BYO TLS inputs are used only when FORTIFY_TLS_MODE=byo. Keep the private key
# outside Git; secrets/input is gitignored if you want a repo-local handoff path.
export FORTIFY_BYO_TLS_CERT=""
export FORTIFY_BYO_TLS_KEY=""
export FORTIFY_BYO_TLS_CA_CERT=""

#uncomment out the line below and provide a location where certicates wll be stored
#default location for certicates will be $HOME/.local/share/mkcert
export FORTIFY_CERTS=$FORTIFY_HOME_K8S/certs

export FORTIFY_RULES_CERT=$FORTIFY_CERTS/$FORTIFY_RULES_DOMAIN.crt

#names for the certs
export ROOTCA_CERT=$FORTIFY_CERTS/rootCA.pem

export ROOTCA_KEY=$FORTIFY_CERTS/rootCA-key.pem

export ROOTCA_PFX=$FORTIFY_CERTS/rootCA.pfx

export SERVER_CERT=$FORTIFY_CERTS/tls.crt

export SERVER_KEY=$FORTIFY_CERTS/tls.key

export KEYSTORE=$FORTIFY_CERTS/keystore.p12

export LIM_SIGNING_CERT_PEM=$ROOTCA_CERT

export LIM_SIGNING_CERT_PFX=$ROOTCA_PFX

export LIM_SIGNING_KEY_PEM=$ROOTCA_KEY

export LIM_SERVER_CERT_PEM=$SERVER_CERT

export LIM_SERVER_KEY_PEM=$SERVER_KEY

export LIM_SIGNING_CERT_PWD="$DEFAULT_PASS"

#--------------------------
# SECTION: KEYSTORES
#--------------------------

export JVM_KEYSTORE=$FORTIFY_CERTS/keystore.jks

export TRUSTSTORE=$FORTIFY_CERTS/truststore

#--------------------------
# SECTION: IMAGE VERSIONS
#--------------------------
# Change these to update which versions get deployed
# FORTIFY_FLIGHT_PLAN names the curated Fortify version bundle selected by the wizard.

export FORTIFY_FLIGHT_PLAN="fortify-26.2"
# Comma-separated components intentionally drifted from the selected Flight Plan.
# Managed by the advanced component override workflow; keep empty for normal labs.
export FORTIFY_FLIGHT_PLAN_DRIFT_COMPONENTS=""

export FORTIFY_SSC_CHART_VERSION="26.2.0-1"
export FORTIFY_SSC_IMAGE_TAG="26.2.0.0183"

export FORTIFY_SCSAST_CHART_VERSION="26.2.0-1"
export FORTIFY_SCSAST_CTRL_IMAGE_TAG="26.2.0"
export FORTIFY_SCSAST_WORKER_IMAGE_TAG="25.2.0"

export FORTIFY_SCDAST_CHART_VERSION="24.4.0-2"

export FORTIFY_LIM_CHART_VERSION="24.4.0-3"

export FORTIFY_MYSQL_CHART_VERSION="9.19.0"
export FORTIFY_POSTGRES_CHART_VERSION="18.6.2"
export FORTIFY_POSTGRES_IMAGE_TAG="17.6.0-debian-12-r4"
export FORTIFY_MYSQL_IMAGE_TAG="8.0.36-debian-11-r2"

# Fortify CLI (fcli) readiness. FCLI is recommended for post-deploy command-line
# workflows, but it is not required for infrastructure deployment profiles.
export FORTIFY_RECOMMENDED_FCLI_VERSION="3.23.3"
export FORTIFY_FCLI_INSTALL_DIR="$HOME/fortify/tools/bin"

#--------------------------
# SECTION: SAMPLE APPLICATIONS
#--------------------------
# Intentionally vulnerable OWASP training targets. Deploy only on isolated lab networks.
export JUICE_SHOP="juice-shop.$DOMAIN"
export WEBGOAT="webgoat.$DOMAIN"
export DVWA="dvwa.$DOMAIN"
export JUICE_SHOP_URL="https://$JUICE_SHOP"
export WEBGOAT_URL="https://$WEBGOAT"
export DVWA_URL="https://$DVWA"
export FORTIFY_SAMPLE_JUICE_SHOP_IMAGE="bkimminich/juice-shop:latest"
export FORTIFY_SAMPLE_WEBGOAT_IMAGE="webgoat/webgoat:latest"
export FORTIFY_SAMPLE_DVWA_IMAGE="vulnerables/web-dvwa:latest"
